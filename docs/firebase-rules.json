{
  "rules": {
    "game": {
      ".read": true,
      ".write": true
    },
    "game-test": {
      ".read": true,
      ".write": true
    },
    "reactions": {
      ".read": true,
      ".write": true
    },
    "messages": {
      ".read": true,
      "$root": {
        "$messageId": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "!newData.exists() || (newData.hasChildren(['text', 'name']) && newData.child('text').isString() && newData.child('text').val().length <= 600)"
        }
      }
    },
    "survey": {
      "config": {
        ".read": true,
        ".write": true
      },
      "responses": {
        ".read": true,
        "$respondentId": {
          ".write": "root.child('survey/config/open').val() !== false"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
