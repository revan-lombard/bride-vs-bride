{
  "rules": {
    "game": {
      ".read": true,
      ".write": true
    },
    "game-test": {
      ".read": true,
      ".write": true
    },
    "survey": {
      "config": {
        ".read": true,
        ".write": true
      },
      "responses": {
        ".read": true,
        "$respondentId": {
          ".write": "root.child('survey/config/open').val() !== false"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
